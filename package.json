{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight collaborative document editor (Ajaia take-home)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.2",
    "vite": "^6.4.6"
  }
}
